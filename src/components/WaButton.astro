---
// Tombol CTA tunggal. Teks tidak boleh diubah antar section.
const { location = 'hero', class: cls = '' } = Astro.props;

const PHONE = '6281190000281';

const MESSAGE = [
  'Halo TOBO Interior, saya ingin mendiskusikan rencana renovasi interior.',
  '',
  'Lokasi: ',
  'Jenis ruang: ',
  'Perkiraan luas: ',
  'Target mulai: ',
].join('\n');

const href = `https://wa.me/${PHONE}?text=${encodeURIComponent(MESSAGE)}`;
---

<a
  href={href}
  class={`btn ${cls}`}
  data-wa={location}
  target="_blank"
  rel="noopener"
>
  Diskusikan Rencana Proyek Anda
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"/>
  </svg>
</a>
